{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farmgame-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  // Anthropic SDK 需要 Node 內建模組（stream/buffer 等）
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game",
      "database_id": "4c9adc73-97cf-4be0-bcde-089f678d6f65"
    }
  ]
}
